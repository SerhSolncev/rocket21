extends ../layout/base

block variables

    - var title='';
    - var description='';
    - var pageClass='main';
    - var footer = true
block content
    section.section.section--top.js-stars
        .top-elips
            include ../includes/modules/elips
        .container
            .top-block
                .top-block__left.js-inview
                    a(href="#").top-icon.top-icon--sec
                        img(src='content/images/icons/icon2.png' width="85" height="85")
                    h1.top-block__title ROCKET YOUR <br> TRADING SKILLS
                    .top-block__mark
                        img(src='content/images/pics/mark.png' width="325" height="35")
                        span 4,529 REVIEWS ON
                    .top-block__buttons
                        a(href="#").button.button--def.button--white TAKE OUR CHALLENGE
                        a(href="#").button.button--def.button--dark JOIN OUR DISCORD
                .top-block__img.js-inview
                    a(href="#").top-icon.top-icon--first
                        img(src='content/images/icons/icon1.png' width="85" height="85")
                    a(href="#").top-icon.top-icon--four
                        img(src='content/images/icons/icon4.png' width="85" height="85")
                    a(href="#").top-icon.top-icon--third
                        img(src='content/images/icons/icon3.png' width="85" height="85")
                    a(href="#").top-block__play
                        img(src="content/images/icons/play.svg" width="100" height="100" alt="planet1")
                    img(src='content/images/pics/cosmo1-test-2.png' width="670" height="677" alt="cosmo1")
    section.section.section--rocket
        .container
            .rocket-block
                .rocket-block__left.js-inview
                    h2.title.title--section.title--ttu.title--bold.title--white
                        | WE HAVE CREATED A UNIQUE
                        span  TRADING EXPERIENCE
                    .simple-text
                        p OUR EVALUATION SYSTEM CONSISTS OF TWO PHASES WHERE WE FOCUS ON IDENTIFYING TRADER’S THAT PROVIDE DATA THAT CAN BE USED IN FINANCIAL MARKETS.

                        p AFTER HAVING COMPLETED THE EVALUATION SYSTEM THE TRADER CAN RECEIVE A BALANCE OF UP TO 600,000 USD VIRTUAL FUNDS.

                        p <strong>#REACHNEWLEVELS</strong>
                .rocket-block__img.js-inview
                    img(src='content/images/empty.gif' class="lazy" data-src="content/images/pics/rocket.png" width="678" height="678" alt="rocket")
    section.section.section--evaluation
        .container
            .evaluation-block
                .evaluation-block__top.js-inview
                    h2.title.title--section-two.title--ttu.title--bold.title--white EVALUATION PROCESS
                .evaluation-block__list
                    .evaluation-item.js-inview(style="background-image: url(content/images/pics/bg-evo.png)")
                        .evaluation-item__body
                            .evaluation-item__numb
                                span 1
                                img(src='content/images/icons/cirk-back.svg' width="75" height="19")
                            .title.title--mid-two.title--ttu.title--bold.title--white START CHALLENGE

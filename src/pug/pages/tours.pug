extends ../layout/base

block variables

    - var title='';
    - var description='';
    - var pageClass='main';
    - var footer = true
block content
    +header('OUR TOURS')
    section.section.section--top-tours.js-stars
        .container
            .top-tours
                .top-tours__left.js-inview
                    h1.top-tours__title OUR TRIPS AROUND THE WORLD
                    .simple-text.simple-text--small
                        p Our trips around the world have been nothing short of extraordinaryadventures, filled with awe-inspiring moments and unforgettable memories.
                        p From the bustling streets of London to the serene landscapes of Dominican Republic, each journey has offered a unique and enriching experience.
                    .top-tours__buttons
                        a(href="#").red-btn
                            .red-btn__text join our community
                .top-tours__img.js-inview
                    img(src='content/images/pics/planet-big.png' width="889" height="889" alt="cosmo1")
    section.section.section--country
        .container
            .country-block
                .country-block__top
                    .country-block__left.js-inview
                        .country-block__top-title
                            h3.country-block__title DOMINICAN REPUBLIC
                            .country-block__icon
                                img(src='content/images/icons/dominican.png' width="66" height="66" alt="cosmo1")
                        p.country-block__text On our Tour of the Dominican Republic, Rocket21 was embraced by the warmth of the local people. We take pride in not only sharing experiences, but also awarding over $2M in challenges, reaffirming our commitment to the growth of our loyal traders.
                        a(href='#').country-block__link
                            img(src='content/images/icons/play-circle.svg' width="889" height="889" alt="cosmo1")
                            span view recap
                    .country-count.js-inview
